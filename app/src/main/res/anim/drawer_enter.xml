<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <translate android:fromYDelta="12dp" android:toYDelta="0" android:duration="180" />
    <scale android:fromXScale="0.97" android:toXScale="1"
        android:fromYScale="0.97" android:toYScale="1"
        android:pivotX="0%" android:pivotY="0%" android:duration="180" />
</set>
