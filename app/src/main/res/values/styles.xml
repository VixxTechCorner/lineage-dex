<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#94F6D1</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101A29</item>
        <item name="android:navigationBarColor">#101A29</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101A29</item>
    </style>
    <style name="DrawerWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/drawer_enter</item>
        <item name="android:windowExitAnimation">@anim/drawer_exit</item>
    </style>
</resources>
